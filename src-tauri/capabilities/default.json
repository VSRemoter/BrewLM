{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Files outside the app's own folder are reachable only once the user picks them in a dialog (the dialog adds each pick to the fs scope); the one exception is writing the database file when restoring a backup.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/brewlm.db" },
        { "path": "$APPDATA/brewlm.db-wal" },
        { "path": "$APPDATA/brewlm.db-shm" }
      ]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" }
      ]
    },
    "store:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default"
  ]
}
