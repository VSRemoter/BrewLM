{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrewLM",
  "version": "0.5.0",
  "identifier": "com.brewlm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrewLM",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BrewLM",
    "copyright": "© 2026 BrewLM contributors",
    "homepage": "https://brewlm.com",
    "license": "Apache-2.0",
    "category": "Productivity",
    "shortDescription": "Your personal research copilot",
    "longDescription": "BrewLM is a local-first, NotebookLM-style research and study app. Add PDFs, web pages, YouTube videos, notes, images and audio, ask questions with cited answers, and turn your sources into flashcards, quizzes, mind maps, reports, deep research and podcast-style audio overviews — with the AI model of your choice. Everything stays on your computer.",
    "externalBin": [
      "binaries/cloudflared"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    }
  }
}
