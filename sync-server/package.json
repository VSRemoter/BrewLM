{
  "name": "brewlm-sync-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply brewlm-sync --local",
    "migrate:remote": "wrangler d1 migrations apply brewlm-sync --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.148.0"
  }
}
