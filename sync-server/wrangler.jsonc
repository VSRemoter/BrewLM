{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brewlm-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served at https://sync.brewlm.com (Cloudflare creates the DNS record and
  // certificate on deploy; brewlm.com must be a zone in this account).
  "routes": [{ "pattern": "sync.brewlm.com", "custom_domain": true }],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "brewlm-sync-blobs" }],
  // Requests per signed-in account per minute (src/index.ts): stops one
  // account flooding the server. Far above what the app sends.
  "ratelimits": [{ "name": "ACCOUNT_RATE", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  // Accounts, sessions and subscriptions. Run migrations with
  // `npx wrangler d1 migrations apply brewlm-sync --local` (or --remote).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brewlm-sync",
      "database_id": "6300334e-53d4-476d-8de5-c27a61c46df1",
      "migrations_dir": "migrations"
    }
  ],
  // Public settings. Secrets (RESEND_API_KEY, POLAR_ACCESS_TOKEN,
  // POLAR_WEBHOOK_SECRET, SYNC_DEV_TOKEN, OPENROUTER_MANAGEMENT_KEY,
  // AI_KEY_SECRET, TURNSTILE_SECRET, and AI_PAUSED for emergencies) go in
  // .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    // PUBLIC_URL and POLAR_API_URL are overridden in .dev.vars for local development.
    "PUBLIC_URL": "https://sync.brewlm.com",
    "POLAR_API_URL": "https://api.polar.sh",
    // OpenRouter's API, where BrewLM AI keys are created (src/openrouter.ts).
    "OPENROUTER_API_URL": "https://openrouter.ai/api/v1",
    "EMAIL_FROM": "BrewLM <signin@brewlm.com>",
    // Web app origins allowed to call the API (comma-separated): the deployed
    // phone app, and `npm run dev:web` for testing against this server.
    "CORS_ORIGINS": "https://app.brewlm.com,http://localhost:1430",
    "POLAR_PRODUCT_SYNC_MONTHLY": "2c5b79e7-3ea2-497a-bcf8-3fa70f50cdad",
    "POLAR_PRODUCT_SYNC_YEARLY": "8b553fae-d7ce-415d-aec4-c03e7b00e63f",
    "POLAR_PRODUCT_PLUS_MONTHLY": "7a50c5ce-dabb-4127-9a52-558945554dcf",
    "POLAR_PRODUCT_PLUS_YEARLY": "07300213-6aa1-4e95-bfb9-4d4dc15c440b",
    // BrewLM AI plans and the one-time AI top-up: fill in once the products
    // exist in Polar (empty = not for sale yet; checkout answers 503).
    "POLAR_PRODUCT_PRO_MONTHLY": "",
    "POLAR_PRODUCT_PRO_YEARLY": "",
    "POLAR_PRODUCT_MAX_MONTHLY": "",
    "POLAR_PRODUCT_MAX_YEARLY": "",
    "POLAR_PRODUCT_AI_TOPUP": "",
    // BrewLM AI's whole OpenRouter spend per UTC day (src/aiGuard.ts): an email
    // at the alert, BrewLM AI paused until the next day at the ceiling, and an
    // email when the OpenRouter credit left drops below the low balance. US dollars.
    "AI_DAILY_ALERT_USD": "20",
    "AI_DAILY_CEILING_USD": "60",
    "AI_LOW_BALANCE_USD": "25",
    // Cloudflare Turnstile on the sign-in confirm page (empty = off). The secret
    // is TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": ""
  },
  // Hourly: delete expired and abandoned shared links (src/shares.ts sweepShares);
  // grant, revoke and roll over BrewLM AI allowances (src/ai.ts reconcileAll);
  // once a day, the BrewLM AI summary email (src/aiGuard.ts).
  // Every 10 minutes: BrewLM AI's spend against the daily alert and ceiling.
  "triggers": { "crons": ["23 * * * *", "*/10 * * * *"] },
  "observability": { "enabled": true }
}
