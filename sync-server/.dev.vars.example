# Copy to .dev.vars for `npm run dev`.
# The local server's own address (production uses https://sync.brewlm.com).
PUBLIC_URL=http://127.0.0.1:8787
# Shared token for the two-copy dev setup (scripts/sync-dev-copy.sh). Any long random string.
SYNC_DEV_TOKEN=change-me-to-a-long-random-string
# Optional. Without it, sign-in links are printed to this console instead of emailed.
RESEND_API_KEY=
# Optional, for billing in Polar's sandbox (test mode): an organization access token
# and the webhook secret from sandbox.polar.sh → Settings, and sandbox POLAR_PRODUCT_* ids.
POLAR_API_URL=https://sandbox-api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Optional. Takes reported shared links down (POST /v1/admin/shares/:id). Any long random string.
ADMIN_TOKEN=
# Optional. Where admin emails go (needs RESEND_API_KEY): reported shared links, BrewLM AI spending
# alerts and the daily BrewLM AI summary. Without it they're printed here.
REPORT_EMAIL=
# Optional, for BrewLM AI (src/ai.ts). A management key from openrouter.ai/settings/management-keys
# (give it an expiry date) and any long random string that encrypts the per-user keys stored in D1.
# Never change AI_KEY_SECRET once keys exist: stored keys couldn't be read (users would get new ones next month).
OPENROUTER_MANAGEMENT_KEY=
AI_KEY_SECRET=
# Emergency stop for BrewLM AI, without a deploy: `wrangler secret put AI_PAUSED` with 1 pauses it for
# everyone, `wrangler secret delete AI_PAUSED` resumes. (POST /v1/admin/ai/pause does the same, and is
# the usual way.)
AI_PAUSED=
# Optional. Cloudflare Turnstile's secret for the sign-in confirm page (with TURNSTILE_SITE_KEY in wrangler.jsonc).
TURNSTILE_SECRET=
# BrewLM AI's "for sale" switch: 1 offers BrewLM AI and the Pro and Max plans to everyone; empty hides
# them (launch: `wrangler secret put AI_FOR_SALE` with 1). AI_EARLY_ACCESS: comma-separated emails that
# see and can buy them before that (you, testers). Accounts already on Pro or Max always keep theirs.
AI_FOR_SALE=
AI_EARLY_ACCESS=
