// The web app (BrewLM on phones) at https://app.brewlm.com: the files from
// `npm run build:web` (dist-web/), served by Cloudflare as a static site.
// Deploy with `npm run deploy:web` from the repo root.
{
  "$schema": "../sync-server/node_modules/wrangler/config-schema.json",
  "name": "brewlm-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist-web",
    // The app lives at "/" only. A missing file must be a real 404: answering
    // with the page (200, text/html) let browsers and the service worker keep
    // HTML under an old build's script/stylesheet names, breaking the app.
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "app.brewlm.com", "custom_domain": true }],
  "workers_dev": false
}
