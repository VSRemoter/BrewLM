{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite"
      ],
      "port": 1420
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 1430
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "web",
        "--port",
        "1431",
        "--strictPort"
      ],
      "port": 1431
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--mode",
        "web",
        "--port",
        "1430",
        "--strictPort"
      ],
      "port": 1430
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/serve-website.py",
        "1440",
        "../openmindFrontEnd"
      ],
      "port": 1440
    },
    {
      "name": "web-cf",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--prefix",
        "sync-server",
        "--",
        "wrangler",
        "dev",
        "--config",
        "web/wrangler.jsonc",
        "--port",
        "1432",
        "--ip",
        "127.0.0.1"
      ],
      "port": 1432
    }
  ]
}
